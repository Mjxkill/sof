	PLATFORM_HOST_MEM_CAP)

# B20..B27 : mono mics (deinterleave_8_b sinks → mixer16 sources 8..15)
W_BUFFER(20, COMP_BUFFER_SIZE(2,
	COMP_SAMPLE_SIZE(PIPELINE_FORMAT), 1,
	COMP_PERIOD_FRAMES(PCM_MAX_RATE, SCHEDULE_PERIOD)),
	PLATFORM_HOST_MEM_CAP)
W_BUFFER(21, COMP_BUFFER_SIZE(2,
