# V5.4.1 E6.b — playback 8ch matrix 16x8 + mic cross-pipeline tap
#
# Architecture E6.b PIPE 2 play (extension de pipe-matrix-playback.m4 E6.a) :
#
#   PCM 1 (ASIO play 8ch) → B0(8ch) → deinterleave_8_a (instance 0) → B1..B8 (8 mono ASIO)
#                                                                      ↓ (mixer16 sources 0..7)
#                                                          mixer16 (16x8 identity) → B10..B17 (8 mono)
#                                                                      ↑ (mixer16 sources 8..15)
#   B_mic_xport(8ch from PIPE 1) → deinterleave_8_b (instance 1) → B20..B27 (8 mono mics)
#                                                                      ↓
#                                                                interleave_8 → B100(8ch) → SAI7 TX
#
# Identity matrix par défaut : sources [0..7] (ASIO play) → sinks 0..7 passthrough,
# sources [8..15] (mics) gain=0 (muet). User peut activer mic via amixer cset (E6.c).
#
# Cross-pipeline tap : le buffer source des mics vient de PIPE 1 (post-pga 8ch après tee_1to2).
# La connexion se fait via SectionGraph dans le top-level E6b.m4 :
#   dapm(N_DEINTERLEAVE_8_INSTANCE_1_PIPE_2, BUF_PIPE_1_INDEX_5)
#
# F++ auto-detection lock channels=1 sur tous les buffers mono branchés (B1..B8 + B20..B27 + B10..B17).
# tee_1to2 cross-pipeline sink overrun_permitted (déjà géré par tee_1to2_trigger).

include(`utils.m4')
include(`buffer.m4')
include(`pcm.m4')
include(`dai.m4')
include(`pipeline.m4')
include(`mixercontrol.m4')
include(`bytecontrol.m4')
include(`deinterleave_8.m4')
include(`interleave_8.m4')
include(`mixer16.m4')

#
# Components
#

W_PCM_PLAYBACK(PCM_ID, ASIO OUT, 0, 2, SCHEDULE_CORE)

# deinterleave_8 instance 0 : ASIO play 8ch → 8 mono
W_DEINTERLEAVE_8(0, PIPELINE_FORMAT, 2, 2, SCHEDULE_CORE)

# deinterleave_8 instance 1 : mic tap 8ch (cross-pipeline) → 8 mono
W_DEINTERLEAVE_8(1, PIPELINE_FORMAT, 2, 2, SCHEDULE_CORE)

# mixer16 16x8 identity matrix
W_MIXER16(0, PIPELINE_FORMAT, 2, 2, SCHEDULE_CORE, ` ')

# interleave_8 : 8 mono → 1×8ch
W_INTERLEAVE_8(0, PIPELINE_FORMAT, 2, 2, SCHEDULE_CORE)

#
# Buffers
#

# B0 : PCM playback → deinterleave_8_a (8ch ASIO play side)
W_BUFFER(0, COMP_BUFFER_SIZE(2,
	COMP_SAMPLE_SIZE(PIPELINE_FORMAT), 8,
	COMP_PERIOD_FRAMES(PCM_MAX_RATE, SCHEDULE_PERIOD)),
	PLATFORM_HOST_MEM_CAP)

# B100 : interleave_8 → SAI TX (8ch DAI side)
W_BUFFER(100, COMP_BUFFER_SIZE(DAI_PERIODS,
	COMP_SAMPLE_SIZE(PIPELINE_FORMAT), 8,
	COMP_PERIOD_FRAMES(PCM_MAX_RATE, SCHEDULE_PERIOD)),
	PLATFORM_DAI_MEM_CAP)

# B1..B8 : mono ASIO play (deinterleave_8_a sinks → mixer16 sources 0..7)
